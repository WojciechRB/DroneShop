
@inherits LayoutComponentBase

<div class="min-vh-100 text-light"
     style="background-color: #090A0F;">

    <nav class="navbar navbar-expand-lg navbar-dark sticky-top border-bottom"
         style="background-color: rgba(9,10,15,0.96);
                border-color: rgba(255,255,255,0.08) !important;">

        <div class="container-fluid px-lg-5 py-2">

            <a class="navbar-brand fw-bold fs-4" href="/">
                <span style="color: #00F0FF;">AERO</span>
                <span class="small text-secondary ms-1">SYSTEMS</span>
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavigation">

                <ul class="navbar-nav mx-auto gap-lg-4">

                    <li class="nav-item">
                        <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                            Home
                        </NavLink>
                    </li>

                    <li class="nav-item">
                        <NavLink class="nav-link" href="/drones">
                            Drones
                        </NavLink>
                    </li>

                    <li class="nav-item">
                        <NavLink class="nav-link" href="/technology">
                            Technology
                        </NavLink>
                    </li>

                    <li class="nav-item">
                        <NavLink class="nav-link" href="/about">
                            About
                        </NavLink>
                    </li>

                </ul>

                <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">

                    <a href="#" class="text-decoration-none text-light small">
                        🛒 Cart (0)
                    </a>

                    <a href="/drones"
                       class="btn btn-sm fw-bold rounded-0 px-4 py-2"
                       style="background-color: #00F0FF;
                              color: #090A0F;">
                        EXPLORE STORE
                    </a>

                </div>

            </div>
        </div>
    </nav>

    <main>
        @Body
    </main>

</div>
