@page "/drones"
@layout MainLayout

<PageTitle>AERO | Drone Collection</PageTitle>

<section class="py-5">

    <div class="container-fluid px-3 px-lg-5 py-4">

        <div class="mb-5">
            <div class="small mb-2" style="color: #00F0FF;">
                / OUR HARDWARE
            </div>

            <h1 class="display-4 fw-bold"
                style="font-family: 'Space Grotesk', sans-serif;">
                THE FLEET.
            </h1>

            <p class="text-secondary">
                Discover our next-generation autonomous flight systems.
            </p>
        </div>

        <div class="row g-4">

            <!-- AERO X1 -->
            <div class="col-md-6 col-xl-4">
                <div class="p-3 h-100"
                     style="background: #12141D; border: 1px solid rgba(255,255,255,0.08);">

                    <img src="https://images.unsplash.com/photo-1506947411487-a56738267384?w=800"
                         class="img-fluid w-100 mb-4"
                         alt="AERO X1 drone"
                         style="height: 240px; object-fit: cover;" />

                    <div class="small mb-2" style="color: #00F0FF;">
                        SERIES 01 / CINEMATIC
                    </div>

                    <h3 class="fw-bold">AERO X1</h3>

                    <p class="text-secondary">
                        Compact professional drone for cinematic aerial photography.
                    </p>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <h4 class="fw-bold mb-0">$1,499</h4>

                        <button class="btn rounded-0 fw-bold"
                                style="background: #00F0FF; color: #090A0F;">
                            VIEW PRODUCT
                        </button>
                    </div>

                </div>
            </div>

            <!-- AERO PRO -->
            <div class="col-md-6 col-xl-4">
                <div class="p-3 h-100"
                     style="background: #12141D; border: 1px solid rgba(255,255,255,0.08);">

                    <img src="https://images.unsplash.com/photo-1527977966376-1c8408f9f108?w=800"
                         class="img-fluid w-100 mb-4"
                         alt="AERO PRO drone"
                         style="height: 240px; object-fit: cover;" />

                    <div class="small mb-2" style="color: #00F0FF;">
                        SERIES 02 / PROFESSIONAL
                    </div>

                    <h3 class="fw-bold">AERO PRO</h3>

                    <p class="text-secondary">
                        Advanced aerial platform for commercial production and surveying.
                    </p>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <h4 class="fw-bold mb-0">$2,899</h4>

                        <button class="btn rounded-0 fw-bold"
                                style="background: #00F0FF; color: #090A0F;">
                            VIEW PRODUCT
                        </button>
                    </div>

                </div>
            </div>

            <!-- AERO TITAN -->
            <div class="col-md-6 col-xl-4">
                <div class="p-3 h-100"
                     style="background: #12141D; border: 1px solid rgba(255,255,255,0.08);">

                    <img src="https://images.unsplash.com/photo-1579829366248-204fe8413f31?w=800"
                         class="img-fluid w-100 mb-4"
                         alt="AERO TITAN drone"
                         style="height: 240px; object-fit: cover;" />

                    <div class="small mb-2" style="color: #00F0FF;">
                        SERIES 03 / INDUSTRIAL
                    </div>

                    <h3 class="fw-bold">AERO TITAN</h3>

                    <p class="text-secondary">
                        Industrial drone designed for demanding autonomous missions.
                    </p>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <h4 class="fw-bold mb-0">$4,999</h4>

                        <button class="btn rounded-0 fw-bold"
                                style="background: #00F0FF; color: #090A0F;">
                            VIEW PRODUCT
                        </button>
                    </div>

                </div>
            </div>

        </div>

    </div>

</section>
