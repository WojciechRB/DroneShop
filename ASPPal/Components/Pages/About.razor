@page "/about"
@layout MainLayout

<PageTitle>AERO | About Us</PageTitle>

<section class="py-5">

    <div class="container-fluid px-3 px-lg-5 py-5">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                <div class="small mb-3" style="color: #00F0FF;">
                    / ABOUT AERO SYSTEMS
                </div>

                <h1 class="display-4 fw-bold mb-4"
                    style="font-family: 'Space Grotesk', sans-serif;">

                    ENGINEERING<br />
                    THE <span style="color: #00F0FF;">FUTURE.</span>

                </h1>

                <p class="lead text-secondary">
                    We believe the future of flight belongs to
                    intelligent, autonomous and precision-engineered
                    aerial systems.
                </p>

                <p class="text-secondary">
                    AERO Systems represents a new approach to drone
                    technology, combining advanced engineering,
                    cinematic performance and intelligent automation.
                </p>

                <a href="/drones"
                   class="btn rounded-0 fw-bold px-4 py-3 mt-3"
                   style="background: #00F0FF; color: #090A0F;">
                    EXPLORE OUR FLEET →
                </a>

            </div>

            <div class="col-lg-6">

                <img src="https://images.unsplash.com/photo-1473968512647-3e447244af8f?w=1200"
                     alt="AERO autonomous drone"
                     class="img-fluid w-100 rounded-2"
                     style="max-height: 500px; object-fit: cover;
                border: 1px solid rgba(0,240,255,0.2);" />

            </div>

        </div>

    </div>

</section>
