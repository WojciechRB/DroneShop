@page "/technology"
@layout MainLayout

<PageTitle>AERO | Technology</PageTitle>

<section class="py-5">

    <div class="container-fluid px-3 px-lg-5 py-5">

        <div class="mb-5">
            <div class="small mb-2" style="color: #00F0FF;">
                / ENGINEERING EXCELLENCE
            </div>

            <h1 class="display-4 fw-bold"
                style="font-family: 'Space Grotesk', sans-serif;">
                FLIGHT <span style="color: #00F0FF;">INTELLIGENCE.</span>
            </h1>

            <p class="text-secondary">
                Technology designed to push autonomous flight further.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-6">
                <div class="p-4 h-100"
                     style="background: #12141D; border: 1px solid rgba(0,240,255,0.2);">

                    <div class="display-5 fw-bold mb-3"
                         style="color: #00F0FF;">
                        360°
                    </div>

                    <h3 class="h4 fw-bold">Obstacle Detection</h3>

                    <p class="text-secondary mb-0">
                        Advanced environmental sensing for improved
                        awareness and flight safety.
                    </p>

                </div>
            </div>

            <div class="col-md-6">
                <div class="p-4 h-100"
                     style="background: #12141D; border: 1px solid rgba(0,240,255,0.2);">

                    <div class="display-5 fw-bold mb-3"
                         style="color: #00F0FF;">
                        RTK
                    </div>

                    <h3 class="h4 fw-bold">Precision GPS</h3>

                    <p class="text-secondary mb-0">
                        High-accuracy positioning for professional
                        aerial surveying and mapping.
                    </p>

                </div>
            </div>

            <div class="col-md-6">
                <div class="p-4 h-100"
                     style="background: #12141D; border: 1px solid rgba(0,240,255,0.2);">

                    <div class="display-5 fw-bold mb-3"
                         style="color: #00F0FF;">
                        AI
                    </div>

                    <h3 class="h4 fw-bold">Autonomous Flight</h3>

                    <p class="text-secondary mb-0">
                        Intelligent flight planning and automated
                        mission execution.
                    </p>

                </div>
            </div>

            <div class="col-md-6">
                <div class="p-4 h-100"
                     style="background: #12141D; border: 1px solid rgba(0,240,255,0.2);">

                    <div class="display-5 fw-bold mb-3"
                         style="color: #00F0FF;">
                        8K
                    </div>

                    <h3 class="h4 fw-bold">Cinematic Imaging</h3>

                    <p class="text-secondary mb-0">
                        High-resolution imaging technology
                        for professional aerial content.
                    </p>

                </div>
            </div>

        </div>

    </div>

</section>
